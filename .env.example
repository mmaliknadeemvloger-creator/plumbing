# ── Public (safe to commit) ───────────────────────────────────
# Canonical origin – set to the real domain before launch
NEXT_PUBLIC_SITE_URL=https://steadwellplumbing.com

# Main phone – unset = temporary 555 number (kept out of schema)
# NEXT_PUBLIC_BUSINESS_PHONE=(704) 555-0123
# NEXT_PUBLIC_BUSINESS_PHONE_E164=+17045550123

# PPC call-tracking number on /lp/* pages
# NEXT_PUBLIC_PPC_TRACKING_PHONE=

# Contact facts – hidden when empty
# NEXT_PUBLIC_BUSINESS_EMAIL=
# NEXT_PUBLIC_BUSINESS_HOURS=Mon–Fri 7 AM–6 PM, Sat 8 AM–2 PM

# Contractor license – shown and put in schema only when set
# NEXT_PUBLIC_LICENSE_NUMBER=

# Real staffed office only – empty = "service-area business"
# NEXT_PUBLIC_OFFICE_ADDRESS=

# Set to "true" ONLY if 24/7 dispatch is actually staffed
# NEXT_PUBLIC_EMERGENCY_24_7=false

# Google review links – turns on the review invitation block
# NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# NEXT_PUBLIC_GOOGLE_PROFILE_URL=

# ── Analytics / Search Console ────────────────────────────────
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Private (never commit) ───────────────────────────────────
# Lead delivery (HMAC-signed webhook)
# LEAD_WEBHOOK_URL=
# LEAD_WEBHOOK_SECRET=

# Prisma lead storage
# DATABASE_URL=
